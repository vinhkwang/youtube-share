# ── Ruby ─────────────────────────────────────────────────────────────────────
*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

# ── Rails ────────────────────────────────────────────────────────────────────
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/tmp/cache/*
!/tmp/cache/.keep
/public/system
/public/uploads
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore all logfiles and tempfiles
*.log
*.pid
*.seed
*.pid.lock

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
/config/master.key
/config/credentials/*.key

# ── Database ─────────────────────────────────────────────────────────────────
/db/schema.rb

# ── Bundler ──────────────────────────────────────────────────────────────────
/.bundle
/vendor/bundle

# ── Node / Frontend (if any) ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
/frontend/build/
/frontend/.env
/frontend/.env.local

# ── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing ──────────────────────────────────────────────────────────────────
/coverage/
.rspec_status

# ── Docker ───────────────────────────────────────────────────────────────────
